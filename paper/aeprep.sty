% aeprep.sty -- two-column preprint layout following the article layout of Applied Energy
% (structure, type sizes and spacing only; no journal branding). Compile with XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aeprep}[2026/10/26 Applied-Energy-style preprint layout]

%% page geometry: 210 x 280 mm journal page, two columns
\RequirePackage[paperwidth=210mm,paperheight=280mm,top=20mm,bottom=19mm,left=13.5mm,right=13.5mm,
  columnsep=6mm,headheight=9pt,headsep=5.5mm,footskip=8mm]{geometry}

%% fonts: Charis SIL text (as in Elsevier journals), STIX Two mathematics
\RequirePackage{amsmath,amsthm,mathtools}
\RequirePackage{fontspec}
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\setmainfont{Charis SIL}[Scale=0.93]
\setmathfont{STIXTwoMath-Regular.otf}[Scale=MatchLowercase]
\setmathfont{STIXTwoMath-Regular.otf}[range={\mathcal,\mathscr},StylisticSet=1,Scale=MatchLowercase]
\RequirePackage[protrusion=true,expansion=false]{microtype}

%% colours, links
\RequirePackage{xcolor}
\definecolor{aeblue}{RGB}{31,106,165}
\definecolor{aerule}{RGB}{0,0,0}
\RequirePackage[colorlinks=true,linkcolor=aeblue,citecolor=aeblue,urlcolor=aeblue,
  bookmarksnumbered=true,pdfstartview=FitH]{hyperref}

%% floats, tables, lists
\RequirePackage{graphicx,booktabs,array,tabularx,multirow,makecell,dblfloatfix,multicol,enumitem,ragged2e}
\RequirePackage[font={footnotesize},labelfont=bf,labelsep=period,justification=justified,
  singlelinecheck=true,skip=4pt]{caption}
\captionsetup[figure]{name=Fig.}
\captionsetup[table]{labelsep=newline,justification=raggedright,singlelinecheck=false,position=top,skip=2pt}
\setlength{\abovecaptionskip}{4pt}
\setlength{\belowcaptionskip}{0pt}
\setlength{\textfloatsep}{10pt plus 2pt minus 3pt}
\setlength{\dbltextfloatsep}{12pt plus 2pt minus 3pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\dblfloatsep}{10pt plus 2pt minus 2pt}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.6}
\renewcommand{\textfraction}{0.06}
\renewcommand{\floatpagefraction}{0.85}
\renewcommand{\dbltopfraction}{0.92}
\renewcommand{\dblfloatpagefraction}{0.85}
\setcounter{topnumber}{3}
\setcounter{dbltopnumber}{3}
\setcounter{totalnumber}{5}
\renewcommand{\arraystretch}{1.12}
\setlength{\tabcolsep}{4pt}
\setlist{nosep,leftmargin=*}

%% headings: "1. Introduction" bold, "2.1. ..." and "2.1.1. ..." italic
\RequirePackage{titlesec}
\renewcommand{\thesection}{\arabic{section}}
\titleformat{\section}{\normalfont\normalsize\bfseries\raggedright}{\thesection.}{0.5em}{}
\titlespacing*{\section}{0pt}{13pt plus 3pt minus 1pt}{6pt plus 1pt}
\titleformat{\subsection}{\normalfont\normalsize\itshape\raggedright}{\thesubsection.}{0.5em}{}
\titlespacing*{\subsection}{0pt}{10pt plus 2pt minus 1pt}{5pt plus 1pt}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape\raggedright}{\thesubsubsection.}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{7pt plus 2pt minus 1pt}{1.5pt}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\itshape}{}{0pt}{}[.]
\titlespacing*{\paragraph}{0pt}{3pt plus 1pt}{0.5em}
\setlength{\parindent}{1.25em}
\setlength{\parskip}{0pt}
\frenchspacing

%% theorem-like statements: bold head, upright body
\newtheoremstyle{aeplain}{4pt plus 1pt}{4pt plus 1pt}{\normalfont}{0pt}{\bfseries}{.}{0.5em}{}
\theoremstyle{aeplain}
\newtheorem{lemma}{Lemma}
\newtheorem{proposition}{Proposition}
\newtheorem{theorem}{Theorem}
\newtheorem{corollary}{Corollary}
\newtheorem{assumption}{Assumption}
\renewenvironment{proof}[1][\proofname]{\par\noindent\textit{#1.}\enspace\ignorespaces}{\hfill$\square$\par\smallskip}

%% running head / foot
\RequirePackage{fancyhdr}
\newcommand{\RunningAuthors}{}
\newcommand{\RunningJournal}{Preprint submitted to \textit{Applied Energy}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\fontsize{7}{8}\selectfont\itshape\RunningAuthors}
\fancyhead[R]{\fontsize{7}{8}\selectfont\itshape\RunningJournal}
\fancyfoot[C]{\fontsize{7.5}{8}\selectfont\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{firstpage}{\fancyhf{}\fancyfoot[C]{\fontsize{7.5}{8}\selectfont\thepage}\renewcommand{\headrulewidth}{0pt}}

%% front matter blocks
\newcommand{\spacedcaps}[1]{{\fontsize{6.6}{8}\selectfont\addfontfeature{LetterSpace=22}\MakeUppercase{#1}}}
\newcommand{\aethinrule}{\par\noindent\rule{\linewidth}{0.4pt}\par}
\newcommand{\aethickrule}{\par\noindent\rule{\linewidth}{1.8pt}\par}

%% nomenclature entries: symbol column + hanging description
\newlength{\nomsymw}
\setlength{\nomsymw}{17mm}
\newcommand{\nomhead}[1]{\par\vspace{3pt}\noindent\textit{#1}\par\vspace{1pt}}
\newcommand{\nom}[2]{\par\noindent\hangindent=\nomsymw\hangafter=1\makebox[\nomsymw][l]{#1}#2\par}

%% algorithm lines (for the pseudocode table)
\newcommand{\algline}[2]{\par\noindent\hangindent=1.4em\hangafter=1\makebox[1.4em][l]{\textbf{#1}}#2\par}
\newcommand{\algsub}[1]{\par\noindent\hangindent=2.6em\hangafter=1\hspace*{1.4em}#1\par}

%% bibliography: small type, numbered labels
\renewcommand{\refname}{References}
\makeatletter
\renewenvironment{thebibliography}[1]{%
  \section*{\refname}\footnotesize
  \list{\@biblabel{\@arabic\c@enumiv}}{\settowidth\labelwidth{\@biblabel{#1}}\leftmargin\labelwidth
    \advance\leftmargin\labelsep\setlength{\itemsep}{0.5pt}\setlength{\parsep}{0pt}
    \usecounter{enumiv}\let\p@enumiv\@empty\renewcommand\theenumiv{\@arabic\c@enumiv}}%
  \sloppy\clubpenalty4000\widowpenalty4000\sfcode`\.\@m}
  {\def\@noitemerr{\@latex@warning{Empty `thebibliography' environment}}\endlist}
\makeatother

\endinput
